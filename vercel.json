{
  "buildCommand": "cd apps/docs && npm install && npm run build",
  "outputDirectory": "apps/docs/dist",
  "installCommand": "echo 'Skipping root install'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

